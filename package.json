{
  "name": "scholasticbase-school-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "vite build && electron-builder --win",
    "package": "vite build && electron-packager . ScholasticBase --platform=win32 --arch=x64 --out=release --overwrite",
    "firebase:seed": "node scripts/seedFirestoreSchema.mjs",
    "firebase:deploy": "npx firebase-tools deploy --only firestore",
    "dataconnect:deploy": "npx firebase-tools deploy --only dataconnect",
    "cap:build": "vite build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:copy": "vite build && npx cap copy android",
    "cap:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "firebase": "^10.14.1",
    "git": "^0.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.16.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.1"
  },
  "allowScripts": {
    "protobufjs@7.6.4": true,
    "esbuild@0.21.5": true,
    "vite@5.4.21": true
  },
  "build": {
    "appId": "com.scholasticbase.app",
    "productName": "ScholasticBase",
    "directories": {
      "output": "release-exe"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/appicon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScholasticBase"
    }
  }
}
